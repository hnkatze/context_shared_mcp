{
  "name": "context-shared-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "context-shared-mcp": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:stdio": "npm run build && node --experimental-strip-types test/e2e.ts",
    "test:http": "npm run build && node --experimental-strip-types test/http-e2e.ts",
    "test:oauth": "npm run build && node --experimental-strip-types test/oauth-e2e.ts",
    "test": "npm run test:stdio && npm run test:http && npm run test:oauth",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22"
  }
}
