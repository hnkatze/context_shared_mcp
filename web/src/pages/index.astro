---
import '../styles/global.css'
import { currentOrgId, withTenant } from "../lib/db";

type Row = {
  card_key: string;
  project: string;
  module: string;
  summary: string;
  why_not_obvious: string;
  author: string;
  updated_at: Date;
};

type ProjectRow = { slug: string; name: string; card_count: string };

let cards: Row[] = [];
let projects: ProjectRow[] = [];
let failure: string | null = null;

try {
  const orgId = await currentOrgId();
  const data = await withTenant(orgId, async (client) => {
    const cardResult = await client.query<Row>(
      `select c.card_key, p.slug as project, c.module, c.summary,
              c.why_not_obvious, c.author, c.updated_at
         from cards c
         join projects p on p.id = c.project_id
        order by c.updated_at desc
        limit 50`,
    );
    const projectResult = await client.query<ProjectRow>(
      `select p.slug, p.name, count(c.id)::text as card_count
         from projects p
         left join cards c on c.project_id = p.id
        group by p.slug, p.name
        order by p.slug`,
    );
    return { cards: cardResult.rows, projects: projectResult.rows };
  });
  cards = data.cards;
  projects = data.projects;
} catch (error) {
  failure = error instanceof Error ? error.message : String(error);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>context_shared</title>
  </head>
  <body>
    <header>
      <h1>Shared context</h1>
    </header>

    <main>
      {failure !== null && (
        <section role="alert">
          <h2>Could not reach the board</h2>
          <p>{failure}</p>
        </section>
      )}

      {failure === null && (
        <>
          <section aria-labelledby="projects-heading">
            <h2 id="projects-heading">Projects</h2>
            {projects.length === 0 ? (
              <p>No projects yet.</p>
            ) : (
              <ul>
                {projects.map((project) => (
                  <li>
                    <strong>{project.slug}</strong> — {project.name} ({project.card_count} cards)
                  </li>
                ))}
              </ul>
            )}
          </section>

          <section aria-labelledby="cards-heading">
            <h2 id="cards-heading">Cards</h2>
            {cards.length === 0 ? (
              <p>Nothing published yet.</p>
            ) : (
              <ul>
                {cards.map((card) => (
                  <li>
                    <article aria-labelledby={`card-${card.card_key}`}>
                      <h3 id={`card-${card.card_key}`}>{card.summary}</h3>
                      <p>
                        {card.project}/{card.module} · {card.author} ·{" "}
                        <time datetime={card.updated_at.toISOString()}>
                          {card.updated_at.toISOString().slice(0, 10)}
                        </time>
                      </p>
                      <p>{card.why_not_obvious}</p>
                    </article>
                  </li>
                ))}
              </ul>
            )}
          </section>
        </>
      )}
    </main>
  </body>
</html>
